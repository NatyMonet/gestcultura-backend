# ============================================================================
# VARIABLES DE ENTORNO - BACKEND GESTCULTURA
# Ficha SENA: 3013183 | Estudiante: Natalia Mejía Cardona
# ----------------------------------------------------------------------------
# Copia este archivo como ".env" y llena los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# Estas mismas variables se configuran en Render (pestaña "Environment").
# ============================================================================

# --- Puerto ---
# En tu equipo puedes dejar 5000. En Render NO lo pongas: Render lo asigna solo.
PORT=5000

# --- Base de datos MySQL ---
# En tu equipo: localhost. En producción: los datos de tu MySQL en la nube
# (Railway / Aiven / Clever Cloud).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=gestion_empatica

# --- Seguridad (tokens de sesión) ---
# Pon una frase larga y secreta (inventada por ti).
JWT_SECRET=una_frase_larga_y_secreta

# --- Dirección del frontend publicado ---
# En tu equipo: http://localhost:5173
# En producción: la URL de tu frontend en Vercel/Netlify
# (sirve para el enlace de recuperar contraseña Y para permitir CORS).
FRONTEND_URL=http://localhost:5173

# --- Correo (recuperación de contraseña, nodemailer) ---
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_de_gmail

# --- Asistente Monet (Google Gemini) ---
GEMINI_API_KEY=tu_api_key_de_gemini

# --- Pasarela de pago Wompi (SOLO MODO PRUEBAS / SANDBOX) ---
# Usa SIEMPRE las llaves de prueba (pub_test_... / test_integrity_...).
# NUNCA las llaves de producción de Cinefilia.
WOMPI_API=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
